# ============================================================================
#  FILE MẪU CẤU HÌNH — KHÔNG chứa thông tin thật, AN TOÀN để chia sẻ / lên git
# ----------------------------------------------------------------------------
#  CÁCH DÙNG:
#    1. Sao chép file này thành .env :  cp .env.example .env   (hoặc: npm run setup)
#    2. Mở .env và điền thông tin THẬT của bạn vào.
#    3. KHÔNG bao giờ commit file .env — nó đã được .gitignore chặn sẵn.
# ============================================================================

# --- Tài khoản đăng nhập WMS (Hasaki) ---
WMS_USERNAME=email@hasaki.vn
WMS_PASSWORD=

# Khoá bí mật 2FA (TOTP) — chuỗi base32 hiện trong Google Authenticator khi quét QR
# (KHÔNG phải mã 6 số; mã 6 số sẽ được crawler tự sinh ra từ khoá này).
WMS_2FA_SECRET=

# --- Cấu hình WMS (có giá trị mặc định trong code, chỉ đổi khi cần) ---
WMS_LOGIN_URL=https://wms.inshasaki.com/login
WMS_API_BASE=https://wms-gw.inshasaki.com/api
WMS_COMPANY_IDS=1001
# Endpoint dữ liệu kiểm kê SKU (đường dẫn sau /api). Đổi nếu bộ lọc khác.
WMS_DATA_PATH=/v1/wms/counting-plan/checklists/type-location
# Tham số lọc dạng query string (tuỳ chọn), ví dụ: warehouse_code=SHOP-170&status=ALL
WMS_DATA_QUERY=

# --- Google Sheets (đích đổ dữ liệu) ---
GOOGLE_SHEET_ID=1Vck9vJv8rvD2Nftd_eqstms98wbw6S4wHNUARAzpWbQ
# Tên tab sẽ ghi dữ liệu thô đã làm sạch vào (crawler tự tạo nếu chưa có)
GOOGLE_SHEET_TAB=RAW_WMS
# Đường dẫn tới file khoá Service Account (.json tải từ Google Cloud Console).
# Nhớ chia sẻ Google Sheet cho email service account với quyền Editor.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# --- Tuỳ chọn vận hành ---
# true = chạy ẩn (không hiện cửa sổ trình duyệt); false = hiện để gỡ lỗi
HEADLESS=true
# Số lần thử lại khi mạng/đăng nhập lỗi
MAX_RETRIES=2

# ============================================================================
#  ĐẨY BÁO CÁO 5S → TASK WORKFLOW (push-5s-to-workflow.js)
# ============================================================================
# Mã bí mật bảo vệ endpoint Apps Script — PHẢI trùng biến SECRET trong google-script.gs
APPSCRIPT_KEY=
# (Tuỳ chọn) ghi đè cấu hình mặc định trong code nếu cần:
APPSCRIPT_URL=
WORKFLOW_ID=591
STAFF_ID=17312

# --- Đăng nhập work.hasaki.vn (login-hasaki.js tự điền email + mật khẩu) ---
HASAKI_EMAIL=
HASAKI_PASSWORD=
# Khoá bí mật 2FA (TOTP) của work.hasaki.vn — chuỗi BASE32 hiện khi quét QR trong
# Google/Microsoft Authenticator (KHÔNG phải mã 6 số). Điền vào đây thì login-hasaki.js
# TỰ SINH + ĐIỀN OTP 6 số → đăng nhập tự động 100% (không cần gõ tay).
# Bỏ trống = giữ chế độ cũ (người gõ OTP thủ công).
HASAKI_2FA_SECRET=

# ── Công tắc vận hành (không phải bí mật) ─────────────────────────────────
# Thư cảnh báo của tầng tự chữa lành. 0 = TẮT (trạng thái đang dùng từ 15/08/2026),
# 1 = bật. Tắt thì cảm biến vẫn chạy và vẫn ghi log, chỉ không gửi mail.
# Chép sang .env khi dựng máy mới, kẻo mail cảnh báo tự sống lại.
CANH_GUI_THU=0

# ── Nộp báo cáo 9 task hằng ngày (task-hangngay.mjs · nút NUT-NOP-TASK.bat) ────
# Từ 19/08/2026 bot KHÔNG tự nộp: lịch "5S Task hang ngay" 16:00 đã tắt, nộp bằng nút bấm tay.
# Giờ sớm nhất được nộp ở chế độ --nop (không hỏi). Chế độ --nut bỏ chốt này vì đã có người bấm.
TASK_GIO_SOM_NHAT=15
# "Giờ thực tế" điền vào task trước khi đổi trạng thái (web bắt buộc, thiếu là 422).
TASK_GIO_THUC_TE=1
# --nut/--lamtuoi: mốc .sync-ok-kiemke/.sync-ok-5s cũ hơn số phút này thì kéo lại trước khi soạn.
TASK_TUOI_TOI_DA=120
# Bấm nút đúng lúc cụm đồng bộ đang chạy: chờ tối đa số phút này cho cụm xong rồi mới đo lại mốc.
TASK_CHO_CUM_PHUT=8
# Câu trung tính cho nhóm B (việc tay) — KHÔNG khai đã làm hay chưa làm.
TASK_BAOCAO_MACDINH=

# ── Kênh ra lệnh bằng tin nhắn (tin-nhan-bot.mjs · Telegram) ──────────────────
# Token bot lấy từ @BotFather trong Telegram (xem KENH-TIN-NHAN.md). Trống = kênh TẮT,
# lịch vẫn chạy nhưng script thoát êm, không nghe gì.
TELEGRAM_BOT_TOKEN=
# Danh sách chat_id ĐƯỢC PHÉP ra lệnh, phân tách bằng dấu phẩy. `--ghepnoi` tự điền.
# Dùng chat_id (số, không đổi được) chứ KHÔNG dùng @username (đổi/giả được).
TELEGRAM_CHAT_ID=
# Ngân sách 1 lượt nghe (giây) — lịch gọi mỗi 2', để 100 là phủ gần liên tục.
TIN_NHAN_GIAY_CHAY=100
# Giữ mỗi kết nối long-poll bao nhiêu giây.
TIN_NHAN_LONG_POLL=45
# Lệnh gõ cũ hơn số phút này thì BỎ (máy tắt qua đêm, Telegram giữ tin 24h — không muốn
# 8h sáng bot chạy sạch mớ lệnh gõ tối qua).
TIN_NHAN_HAN_PHUT=15
# Trần thời gian 1 lệnh (phút) và trần số lệnh mỗi giờ.
TIN_NHAN_CHAY_TOI_DA_PHUT=10
TIN_NHAN_MAX_LENH_GIO=20
# OTP QUA TIN NHẮN (login-hasaki.js --otp-chat): =1 thì lượt đăng nhập TỰ ĐỘNG, thay vì hoãn vì
# không ai gõ OTP, sẽ NHẮN XIN bạn 6 số rồi tự gõ vào SSO. Trống/0 = giữ hành vi cũ (hoãn).
# Lệnh /dangnhap trong chat luôn dùng đường này, không phụ thuộc cờ.
LOGIN_OTP_CHAT=
# Chờ bạn nhắn mã tối đa bao nhiêu giây rồi bỏ lượt (KHÔNG nộp gì lên IdP).
LOGIN_OTP_CHO_GIAY=300
# Xin mà không ai trả lời thì im bao nhiêu phút rồi mới xin lại (chống dội khi bạn đang ngủ/họp).
LOGIN_OTP_NGHI_LAI_PHUT=30
