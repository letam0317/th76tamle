# Danh bạ nhân sự khai tay — có PII, không commit
nhansu-manual.json

# ===== Bảo vệ secret KỂ CẢ KHI thư mục này bị tách thành repo riêng =====
# (Trước đây chỉ dựa vào .gitignore của repo cha — copy đủ rule xuống đây để không mất bảo vệ.)

# Bí mật — TUYỆT ĐỐI không đẩy lên git
.streamlit/secrets.toml
.env
.env.*
!.env.example
*.secret
credentials.json
service-account*.json
.wms-token.json

# Crawler — sản phẩm gỡ lỗi (có thể lộ dữ liệu / phiên đăng nhập)
debug-*.png
debug-*.html
.wms-session/
wms_*.json
ck_*.json
*.xlsx
node_modules/
ui_*.png

# Log & lockfile & marker chạy ngầm theo lịch (không commit)
*.log
*.log.1
.watch-nhiptim
*.lock
.last-sync.json
.exports/
.sync-ok-*
.sync-guard.last-run
# Moc "lan cuoi thay bridge con tuoi" + "kenh bridge wshr da chung thuc" (session-rules).
# Do bang mtime / phai do CHINH may do tu xac nhan -> chep sang may khac la sai, khong commit.
.bridge-thay-cuoi
.bridge-wshr-ok
.session-ledger-state.json
# State/cache của nhịp phân tầng (sync-poller 26/07/2026)
.poller-state.json
# Sổ của kênh tin nhắn (tin-nhan-bot 19/08/2026): offset Telegram + cooldown + nonce chờ xác nhận.
# Theo máy, và offset mà chép sang máy khác là bỏ sót/nhận lại lệnh cũ -> không commit.
.tin-nhan-state.json
# Yêu cầu OTP đang treo (hop-thu.mjs) — sống vài phút, chỉ có nghĩa trên chính máy đang đăng nhập.
.otp-cho.json
# Cầu dao chống khoá tài khoản (login-hasaki 31/07/2026) — trạng thái theo máy
.login-that-bai.json
.sheet-hash.json
# So dong "Ton tai vi tri" da ghi lan truoc (chan ghi de khi quet thieu) — trang thai theo may
.tvt-last.json
.pc-cache.json
.task-baocao-tay.json          # bao cao tay cho nhom B task hang ngay (noi dung cong viec that)
# Cache danh bạ wshr — CÓ PII, tuyệt đối không commit
.cache-danhba.json
# Lịch sử báo cáo vệ sinh 60 ngày (sync-vesinh-all) — CÓ PII (email/tên NV), không commit
.lichsu-vesinh.json
# Chấm công theo ngày 60 ngày (sync-vesinh-all) — CÓ PII, không commit
.chamcong-ngay.json
# Danh mục vị trí cộng dồn (sync-vesinh-all 03/08/2026) — không PII nhưng là state theo máy
.danhmuc-vitri.json

# Bản deploy Apps Script có SECRET thật — KHÔNG commit
google-script-DEPLOY.gs
# Thư mục làm việc clasp (chứa code kéo về từ script live + có secret) — KHÔNG commit
.clasp-deploy/
# Cache tracking cua doi-soat-kiemke (co du lieu ton kho) — ke ca ban theo tung
# ke hoach: DS_PLAN=243605 ghi .doi-soat-cache-plan243605.json (1,1MB dong hang WMS)
.doi-soat-cache*.json
# Tang tu chua lanh (12/08/2026) — state CUC BO cua may tram, do bang lich su cua chinh may nay.
# Chep sang may khac se mang baseline sai -> chan ghi nham hoac bo lot. KHONG commit.
.baseline-tu-chua.json
.canh-suc-khoe.json
.dia-chi-hoc.json

# Ban nhap danh muc SKU_MASTER (sync-sku-master.mjs --dry) — 0,6MB, dung cho bo test doi soat
.sku-master-dry.json
# Ban thang do nguon du lieu SKU (probe-sku-master.mjs)
.probe-*.json
.inside-cookie
.otp-in
.otp-in.wanted
